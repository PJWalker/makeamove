{
  "name": "makeamove",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "npm run lint && npm run check:systems && vp build",
    "ci": "npm run ci:node && npm run ci:install && npm run format:check && npm run lint && npm run deps && npm run knip && npm run dup && npm run check:systems && npm run test:coverage && vp build && npm run verify --if-present",
    "ci:local": "npm run ci && npm run test:browser:local",
    "ci:node": "node -e \"if (Number(process.versions.node.split('.')[0]) < 24) { console.error('Node 24 or later is needed, as package.json engines says; this is ' + process.version); process.exit(1); }\"",
    "ci:install": "npm ci --dry-run --ignore-scripts --no-audit --no-fund",
    "lint": "npm run lint:eslint -- . && vp fmt eslint-suppressions.json && npm run typecheck && npm run doctor",
    "lint:eslint": "eslint --prune-suppressions --no-warn-ignored",
    "check:changed": "jiti scripts/lint.ts",
    "typecheck": "tsc -b",
    "check:systems": "npx jiti scripts/check-systems.ts",
    "graph": "jiti scripts/dependencyGraph.ts",
    "graph:serve": "jiti scripts/dependencyGraph.ts --serve",
    "knip": "knip",
    "dup": "jscpd",
    "deps": "depcruise src --config",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "preview": "vp preview",
    "generate:dice": "jiti scripts/generateDiceFallbacks.ts",
    "verify": "lsc check --backend=dafny",
    "verify:gen": "lsc regen --backend=dafny",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:browser": "vp test run --config vitest.browser.config.ts",
    "test:browser:local": "if [ -n \"$CI\" ] || [ -n \"$CLAUDE_CODE_REMOTE\" ]; then echo 'Browser tests are skipped in the cloud; they run on your own machine.'; else npm run test:browser; fi",
    "generate:rules": "jiti scripts/generateRules.ts",
    "doctor": "npx react-doctor@latest",
    "prepare": "vp config",
    "generate:icons": "jiti scripts/generateIcons.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@mapbox/tiny-sdf": "^2.3.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/static-renderer": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@xstate/react": "^6.1.0",
    "cannon-es": "^0.20.0",
    "fractional-indexing": "^4.0.0",
    "fuse.js": "^7.5.0",
    "lib0": "^0.2.119",
    "perfect-freehand": "^1.2.3",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-doctor": "^0.9.22",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "trystero": "^0.26.0",
    "xstate": "^5.33.4",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^9.39.5",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.101",
    "@svgr/plugin-jsx": "^8.1.0",
    "@swc/core": "^1.16.22",
    "@tiptap/markdown": "3.32.0",
    "@types/eslint-plugin-promise": "^7.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/utils": "^8.72.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "jiti": "2.7.0",
    "jscpd": "5.4.3",
    "knip": "^6.44.1",
    "lemmascript": "^0.6.15",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "playwright": "^1.65.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-macros": "0.23.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "eslint-plugin-promise": {
      "eslint": "$eslint"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0"
  }
}
