{
  "name": "makeamove",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "npm run generate:dice && npm run lint && tsc -b && vp build",
    "lint": "vp lint src scripts vite.config.ts .storybook --max-warnings 0 --fix && npm run lint:storage",
    "lint:storage": "eslint --config eslint/noRawYjs.config.js src --max-warnings 0 --fix",
    "typecheck": "tsc -b",
    "knip": "knip",
    "dup": "jscpd",
    "deps": "depcruise src --config",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "preview": "vp preview",
    "generate:dice": "jiti scripts/generateDiceFallbacks.ts",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:browser": "vp test run --config vitest.browser.config.ts",
    "mutate": "stryker run",
    "generate:rules": "jiti scripts/generateRules.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "doctor": "npx react-doctor@latest",
    "prepare": "vp config"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@mapbox/tiny-sdf": "^2.3.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/static-renderer": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "cannon-es": "^0.20.0",
    "fractional-indexing": "^4.0.0",
    "fuse.js": "^7.5.0",
    "lib0": "^0.2.119",
    "perfect-freehand": "^1.2.3",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-doctor": "^0.9.22",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "trystero": "^0.26.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.96",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@swc/core": "^1.16.22",
    "@tiptap/markdown": "3.32.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/utils": "^8.72.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-doctor": "^0.9.22",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.6",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.14.0",
    "jiti": "2.7.0",
    "jscpd": "5.4.3",
    "knip": "^6.44.1",
    "playwright": "^1.65.0",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "oxlint-tsgolint": "7.0.2006",
    "storybook": "^10.6.6",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-icons": "^24.0.0",
    "unplugin-macros": "0.23.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0"
  }
}
