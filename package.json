{
  "name": "makeamove",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && tsc -b && vite build",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "typecheck": "tsc -b",
    "knip": "knip",
    "dup": "jscpd",
    "deps": "depcruise src --config --ignore-known",
    "deps:baseline": "depcruise src --config --output-type baseline > .dependency-cruiser-known-violations.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/static-renderer": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "@types/three": "^0.187.0",
    "cannon-es": "^0.20.0",
    "fractional-indexing": "^4.0.0",
    "fuse.js": "^7.5.0",
    "lib0": "^0.2.119",
    "perfect-freehand": "^1.2.3",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "trystero": "^0.26.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.96",
    "@playwright/test": "^1.64.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@swc/core": "^1.16.22",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.14.0",
    "jscpd": "5.4.3",
    "knip": "^6.44.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
