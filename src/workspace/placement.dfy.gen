// Generated by lsc from placement.ts

datatype Option<T> = None | Some(value: T)

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype Place = closed | floating | left | right

datatype Placement = Placement(left: seq<string>, right: seq<string>, floating: seq<string>, closed: seq<string>)

datatype Destination = Destination(place: Place, index: int)

function occurrences(ids: seq<string>, id: string): int
  decreases |ids|
{
  if (|ids| == 0) then
    0
  else
    ((if (ids[0] == id) then 1 else 0) + occurrences(ids[1..], id))
}

function count(p: Placement, id: string): int
{
  (((occurrences(p.left, id) + occurrences(p.right, id)) + occurrences(p.floating, id)) + occurrences(p.closed, id))
}

function at(p: Placement, place: Place): seq<string>
{
  if place.left? then
    p.left
  else
    if place.right? then
      p.right
    else
      if place.floating? then
        p.floating
      else
        p.closed
}

function removed(ids: seq<string>, id: string): seq<string>
  decreases |ids|
{
  if (|ids| == 0) then
    []
  else
    var rest := removed(ids[1..], id);
    if (ids[0] == id) then
      rest
    else
      ([ids[0]] + rest)
}

lemma removed_ensures(ids: seq<string>, id: string)
  ensures (occurrences(removed(ids, id), id) == 0)
  ensures forall x :: ((x != id) ==> (occurrences(removed(ids, id), x) == occurrences(ids, x)))
{
}

function inserted(ids: seq<string>, index: int, id: string): seq<string>
{
  var i := MathMin(MathMax(index, 0), |ids|);
  ((ids[0..i] + [id]) + ids[i..])
}

lemma inserted_ensures(ids: seq<string>, index: int, id: string)
  ensures (occurrences(inserted(ids, index, id), id) == (occurrences(ids, id) + 1))
  ensures forall x :: ((x != id) ==> (occurrences(inserted(ids, index, id), x) == occurrences(ids, x)))
{
}

function moved(p: Placement, id: string, to: Destination): Placement
{
  var left := removed(p.left, id);
  var right := removed(p.right, id);
  var floating := removed(p.floating, id);
  var closed := removed(p.closed, id);
  var place := to.place;
  var index := to.index;
  if place.left? then
    Placement(inserted(left, index, id), right, floating, closed)
  else
    if place.right? then
      Placement(left, inserted(right, index, id), floating, closed)
    else
      if place.floating? then
        Placement(left, right, inserted(floating, index, id), closed)
      else
        Placement(left, right, floating, inserted(closed, index, id))
}

lemma moved_ensures(p: Placement, id: string, to: Destination)
  ensures (count(moved(p, id, to), id) == 1)
  ensures (occurrences(at(moved(p, id, to), to.place), id) == 1)
  ensures forall x :: ((x != id) ==> (count(moved(p, id, to), x) == count(p, x)))
  ensures forall x, q: Place :: ((x != id) ==> (occurrences(at(moved(p, id, to), q), x) == occurrences(at(p, q), x)))
{
}

function shownTab(active: Option<string>, panels: seq<string>): Option<string>
{
  match active {
    case Some(i_active_val) =>
      if (i_active_val in panels) then
        Some(i_active_val)
      else
        if (|panels| > 0) then
          Option.Some(panels[0])
        else
          Option.None
    case None =>
      if (|panels| > 0) then
        Option.Some(panels[0])
      else
        Option.None
  }
}

lemma shownTab_ensures(active: Option<string>, panels: seq<string>)
  ensures ((|panels| == 0) <==> (match shownTab(active, panels) { case Some(i_) => false case None => true }))
  ensures (match shownTab(active, panels) { case Some(i_result_val) => (i_result_val in panels) case None => true })
  ensures (match active { case Some(i_active_val) => ((i_active_val in panels) ==> (match shownTab(active, panels) { case Some(i_value) => (i_value == i_active_val) case None => false })) case None => true })
{
