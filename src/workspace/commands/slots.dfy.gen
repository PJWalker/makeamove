datatype Need = none | optional | required

datatype Signature = Signature(subject: Need, object_: Need)

datatype Word = Word(actor: bool, object_: bool, beforeVerb: bool)

datatype Filling = Filling(ok: bool, subject: int, object_: int)

datatype Fallback = Fallback(subject: bool, object_: bool)

function completed(need: Need, typed: int, context: bool): int
{
  if (typed != EMPTY) then
    typed
  else
    if ((!need.none?) && context) then
      CONTEXT
    else
      EMPTY
}

lemma completed_ensures(need: Need, typed: int, context: bool)
  ensures ((typed != EMPTY) ==> (completed(need, typed, context) == typed))
  ensures ((typed == EMPTY) ==> (!need.none?) ==> context ==> (completed(need, typed, context) == CONTEXT))
  ensures ((typed == EMPTY) ==> (need.none? || !(context)) ==> (completed(need, typed, context) == EMPTY))
{
}

const EMPTY: int := -1

const CONTEXT: int := -2

const MOST_NAMES: int := 2

const unfit: Filling := Filling(false, EMPTY, EMPTY)

method fill(sig: Signature, words: seq<Word>, context: Fallback) returns (res: Filling)
  ensures (res.ok ==> (((res.subject == EMPTY) || (res.subject == CONTEXT)) || (((0 <= res.subject) && (res.subject < |words|)) && words[res.subject].actor)))
  ensures (res.ok ==> (((res.object_ == EMPTY) || (res.object_ == CONTEXT)) || (((0 <= res.object_) && (res.object_ < |words|)) && words[res.object_].object_)))
  ensures (res.ok ==> (|words| <= 2))
  ensures (res.ok ==> (|words| >= 1) ==> ((res.subject == 0) || (res.object_ == 0)))
  ensures (res.ok ==> (|words| == 2) ==> ((res.subject == 1) || (res.object_ == 1)))
  ensures (res.ok ==> (res.subject >= 0) ==> (res.subject != res.object_))
  ensures (res.ok ==> sig.subject.none? ==> (res.subject == EMPTY))
  ensures (res.ok ==> sig.object_.none? ==> (res.object_ == EMPTY))
  ensures (res.ok ==> sig.subject.required? ==> (res.subject != EMPTY))
  ensures (res.ok ==> sig.object_.required? ==> (res.object_ != EMPTY))
  ensures (res.ok ==> (res.subject == CONTEXT) ==> context.subject)
  ensures (res.ok ==> (res.object_ == CONTEXT) ==> context.object_)
  ensures (res.ok ==> (!sig.subject.none?) ==> context.subject ==> (res.subject != EMPTY))
  ensures (res.ok ==> (!sig.object_.none?) ==> context.object_ ==> (res.object_ != EMPTY))
  ensures ((|words| == 0) ==> ((!sig.subject.required?) || context.subject) ==> ((!sig.object_.required?) || context.object_) ==> res.ok)
  ensures (!(res.ok) ==> ((res.subject == EMPTY) && (res.object_ == EMPTY)))
{
  var s := EMPTY;
  var o := EMPTY;
  if (|words| > MOST_NAMES) {
    return unfit;
  }
  if (|words| == MOST_NAMES) {
    if (sig.subject.none? || sig.object_.none?) {
      return unfit;
    }
    if (!(words[0].actor) || !(words[1].object_)) {
      return unfit;
    }
    s := 0;
    o := 1;
  } else if (|words| == 1) {
    var w := words[0];
    var asSubject := ((!sig.subject.none?) && w.actor);
    var asObject := ((!sig.object_.none?) && w.object_);
    if (asSubject && (w.beforeVerb || !(asObject))) {
      s := 0;
    } else if asObject {
      o := 0;
    } else {
      return unfit;
    }
  }
  s := completed(sig.subject, s, context.subject);
  o := completed(sig.object_, o, context.object_);
  if (sig.subject.required? && (s == EMPTY)) {
    return unfit;
  }
  if (sig.object_.required? && (o == EMPTY)) {
    return unfit;
  }
  return Filling(true, s, o);
}
