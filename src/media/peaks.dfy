// Generated by lsc from peaks.ts

method firstPeak(scores: seq<real>, start: int, threshold: real) returns (res: int)
  requires (start >= 0)
  ensures ((res == -1) || ((start <= res) && (res < |scores|)))
  ensures ((res != -1) ==> (scores[res] >= threshold))
  ensures ((res != -1) ==> ((res + 1) < |scores|) ==> (scores[(res + 1)] <= scores[res]))
  ensures ((res == -1) ==> forall k: int :: ((start <= k) ==> (k < |scores|) ==> (scores[k] < threshold)))
{
  var index := start;
  while ((index < |scores|) && (scores[index] < threshold))
    invariant (start <= index)
    invariant ((index <= |scores|) || (index == start))
    invariant forall k: int :: ((start <= k) ==> (k < index) ==> (scores[k] < threshold))
    decreases (|scores| - index)
  {
    index := (index + 1);
  }
  if (index >= |scores|) {
    return -1;
  }
  while (((index + 1) < |scores|) && (scores[(index + 1)] > scores[index]))
    invariant (start <= index)
    invariant (index < |scores|)
    invariant (scores[index] >= threshold)
    decreases (|scores| - index)
  {
    index := (index + 1);
  }
  return index;
}
