function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype Box = Box(x: int, y: int, w: int, h: int)

function shiftInside(start: int, size: int, from: int, room: int): int
  requires (size >= 0)
  requires (room >= 0)
{
  if (start < from) then
    (from - start)
  else
    var over := ((start + size) - (from + room));
    if (over > 0) then
      (-(MathMin(over, (start - from))))
    else
      0
}

lemma shiftInside_ensures(start: int, size: int, from: int, room: int)
  requires (size >= 0)
  requires (room >= 0)
  ensures ((start + shiftInside(start, size, from, room)) >= from)
  ensures ((size <= room) ==> (((start + shiftInside(start, size, from, room)) + size) <= (from + room)))
  ensures ((start >= from) ==> ((start + size) <= (from + room)) ==> (shiftInside(start, size, from, room) == 0))
  ensures ((start < from) ==> ((start + shiftInside(start, size, from, room)) == from))
  ensures ((start >= from) ==> ((start + size) > (from + room)) ==> ((((start + shiftInside(start, size, from, room)) + size) == (from + room)) || ((start + shiftInside(start, size, from, room)) == from)))
{
}

method unionRect(boxes: seq<Box>) returns (res: Box)
  requires (|boxes| > 0)
  ensures forall i: nat :: ((i < |boxes|) ==> ((((res.x <= boxes[i].x) && (res.y <= boxes[i].y)) && ((boxes[i].x + boxes[i].w) <= (res.x + res.w))) && ((boxes[i].y + boxes[i].h) <= (res.y + res.h))))
  ensures exists i: nat :: ((i < |boxes|) && (boxes[i].x == res.x))
  ensures exists i: nat :: ((i < |boxes|) && (boxes[i].y == res.y))
  ensures exists i: nat :: ((i < |boxes|) && ((boxes[i].x + boxes[i].w) == (res.x + res.w)))
  ensures exists i: nat :: ((i < |boxes|) && ((boxes[i].y + boxes[i].h) == (res.y + res.h)))
{
  var left := boxes[0].x;
  var top := boxes[0].y;
  var right := (boxes[0].x + boxes[0].w);
  var bottom := (boxes[0].y + boxes[0].h);
  var k := 1;
  while (k < |boxes|)
    invariant (1 <= k)
    invariant (k <= |boxes|)
    invariant forall i: nat :: ((i < k) ==> ((((left <= boxes[i].x) && (top <= boxes[i].y)) && ((boxes[i].x + boxes[i].w) <= right)) && ((boxes[i].y + boxes[i].h) <= bottom)))
    invariant exists i: nat :: ((i < k) && (boxes[i].x == left))
    invariant exists i: nat :: ((i < k) && (boxes[i].y == top))
    invariant exists i: nat :: ((i < k) && ((boxes[i].x + boxes[i].w) == right))
    invariant exists i: nat :: ((i < k) && ((boxes[i].y + boxes[i].h) == bottom))
    decreases (|boxes| - k)
  {
    var box := boxes[k];
    left := MathMin(left, box.x);
    top := MathMin(top, box.y);
    right := MathMax(right, (box.x + box.w));
    bottom := MathMax(bottom, (box.y + box.h));
    k := (k + 1);
  }
  return Box(left, top, (right - left), (bottom - top));
}
