// Generated by lsc from fog.ts

datatype FogMode = auto | manual | none

datatype FogCover = FogCover(hidden: bool, revealed: bool, explored: bool, inSight: bool)

datatype FogPass = clearExplored | clearRevealed | clearSight | cover | coverHidden

datatype FogShade = clear | remembered | unseen

datatype TokenView = TokenView(own: bool, vision: bool, cover: FogCover)

datatype Stratum = aboveFog | fog | grid | light | map_ | over | sight | tint | token | under

datatype ElementLayer = aboveFog | map_ | over | token | under

function isRevealed(mode: FogMode, c: FogCover): bool
{
  (mode.none? || (if c.hidden then false else (c.revealed || (mode.auto? && (c.explored || c.inSight)))))
}

lemma isRevealed_ensures(mode: FogMode, c: FogCover)
  ensures (mode.none? ==> isRevealed(mode, c))
  ensures ((!mode.none?) ==> c.hidden ==> !(isRevealed(mode, c)))
  ensures ((!mode.none?) ==> !(c.hidden) ==> c.revealed ==> isRevealed(mode, c))
  ensures (mode.manual? ==> (isRevealed(mode, c) == (!(c.hidden) && c.revealed)))
  ensures (mode.auto? ==> (isRevealed(mode, c) == (!(c.hidden) && ((c.revealed || c.explored) || c.inSight))))
{
}

function fogPasses(mode: FogMode): seq<FogPass>
{
  if mode.none? then
    []
  else
    if mode.manual? then
      [FogPass.cover, FogPass.clearRevealed, FogPass.coverHidden]
    else
      [FogPass.cover, FogPass.clearExplored, FogPass.clearSight, FogPass.clearRevealed, FogPass.coverHidden]
}

function afterPass(pass: FogPass, clear: bool, c: FogCover): bool
{
  if pass.cover? then
    false
  else
    if pass.clearExplored? then
      (clear || c.explored)
    else
      if pass.clearSight? then
        (clear || c.inSight)
      else
        if pass.clearRevealed? then
          (clear || c.revealed)
        else
          (clear && !(c.hidden))
}

function afterPasses(passes: seq<FogPass>, c: FogCover): bool
  decreases |passes|
{
  ((|passes| == 0) || (var last := passes[(|passes| - 1)]; afterPass(last, afterPasses(passes[0..|passes|-1], c), c)))
}

function paintedClear(mode: FogMode, c: FogCover): bool
{
  afterPasses(fogPasses(mode), c)
}

lemma paintedClear_ensures(mode: FogMode, c: FogCover)
  ensures (paintedClear(mode, c) == isRevealed(mode, c))
{
}

function fogShade(mode: FogMode, vision: bool, c: FogCover): FogShade
{
  if !(isRevealed(mode, c)) then
    FogShade.unseen
  else
    if (vision && !(c.inSight)) then
      if mode.none? then
        FogShade.unseen
      else
        FogShade.remembered
    else
      FogShade.clear
}

lemma fogShade_ensures(mode: FogMode, vision: bool, c: FogCover)
  ensures (fogShade(mode, vision, c).clear? ==> (isRevealed(mode, c) && (!(vision) || c.inSight)))
  ensures (fogShade(mode, vision, c).remembered? ==> (isRevealed(mode, c) && (!mode.none?)))
  ensures ((!mode.none?) ==> c.hidden ==> fogShade(mode, vision, c).unseen?)
  ensures (!(vision) ==> isRevealed(mode, c) ==> fogShade(mode, vision, c).clear?)
{
}

function tokenShows(mode: FogMode, t: TokenView): bool
{
  (t.own || fogShade(mode, t.vision, t.cover).clear?)
}

lemma tokenShows_ensures(mode: FogMode, t: TokenView)
  ensures (tokenShows(mode, t) == (t.own || fogShade(mode, t.vision, t.cover).clear?))
  ensures (!(t.own) ==> (!mode.none?) ==> t.cover.hidden ==> !(tokenShows(mode, t)))
  ensures (!(t.own) ==> !(isRevealed(mode, t.cover)) ==> !(tokenShows(mode, t)))
  ensures (!(t.own) ==> t.vision ==> !(t.cover.inSight) ==> !(tokenShows(mode, t)))
{
}

function stack(): seq<Stratum>
{
  [Stratum.map_, Stratum.grid, Stratum.under, Stratum.token, Stratum.over, Stratum.tint, Stratum.light, Stratum.sight, Stratum.fog, Stratum.aboveFog]
}

function height(s: Stratum): int
{
  if s.map_? then
    0
  else
    if s.grid? then
      1
    else
      if s.under? then
        2
      else
        if s.token? then
          3
        else
          if s.over? then
            4
          else
            if s.tint? then
              5
            else
              if s.light? then
                6
              else
                if s.sight? then
                  7
                else
                  if s.fog? then
                    8
                  else
                    9
}

lemma height_ensures(s: Stratum)
  ensures (0 <= height(s))
  ensures (height(s) < 10)
  ensures (stack()[height(s)] == s)
{
}

function stratumOf(layer: ElementLayer): Stratum
{
  if layer.map_? then
    Stratum.map_
  else
    if layer.under? then
      Stratum.under
    else
      if layer.token? then
        Stratum.token
      else
        if layer.over? then
          Stratum.over
        else
          Stratum.aboveFog
}

function overFog(layer: ElementLayer): bool
{
  (height(stratumOf(layer)) > height(Stratum.fog))
}

lemma overFog_ensures(layer: ElementLayer)
  ensures (overFog(layer) == layer.aboveFog?)
{
}

function elementSeen(layer: ElementLayer, shade: FogShade): bool
{
  ((!shade.unseen?) || overFog(layer))
}

lemma elementSeen_ensures(layer: ElementLayer, shade: FogShade)
  ensures (layer.aboveFog? ==> elementSeen(layer, shade))
  ensures ((!layer.aboveFog?) ==> shade.unseen? ==> !(elementSeen(layer, shade)))
  ensures ((!shade.unseen?) ==> elementSeen(layer, shade))
{
}
