// Generated by lsc from pins.ts

datatype PinLook = broken | hidden | open | secret

datatype PinSight = PinSight(gm: bool, found: bool, gmOnly: bool, inSight: bool)

function pinLook(s: PinSight): PinLook
{
  if !(s.found) then
    if s.gm then
      PinLook.broken
    else
      PinLook.hidden
  else
    if s.gm then
      if s.gmOnly then
        PinLook.secret
      else
        PinLook.open
    else
      if (!(s.gmOnly) && s.inSight) then
        PinLook.open
      else
        PinLook.hidden
}

lemma pinLook_ensures(s: PinSight)
  ensures (!(s.gm) ==> (pinLook(s).open? == ((s.found && !(s.gmOnly)) && s.inSight)))
  ensures (!(s.gm) ==> (pinLook(s).open? || pinLook(s).hidden?))
  ensures (s.gm ==> (!pinLook(s).hidden?))
  ensures (s.gm ==> (pinLook(s).broken? == !(s.found)))
  ensures (pinLook(s).secret? ==> ((s.gm && s.found) && s.gmOnly))
{
}

function pinOpens(look: PinLook): bool
{
  (look.open? || look.secret?)
}

lemma pinOpens_ensures(look: PinLook)
  ensures (pinOpens(look) == (look.open? || look.secret?))
{
}

function canOpenPin(s: PinSight): bool
{
  pinOpens(pinLook(s))
}

lemma canOpenPin_ensures(s: PinSight)
  ensures (canOpenPin(s) ==> (s.found && (s.gm || (!(s.gmOnly) && s.inSight))))
  ensures (s.gm ==> s.found ==> canOpenPin(s))
{
}
