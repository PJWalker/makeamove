// Generated by lsc from resizeRect.ts

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype Rect = Rect(x: int, y: int, w: int, h: int)

datatype ResizeDir = e | n | ne | nw | s | se | sw | w

const MIN_W: int := 260

const MIN_H: int := 200

method resizeRect(start: Rect, dir: ResizeDir, dx: int, dy: int) returns (res: Rect)
  ensures (if (dir.n? || dir.s?) then (res.w == start.w) else (res.w >= MIN_W))
  ensures (if (dir.e? || dir.w?) then (res.h == start.h) else (res.h >= MIN_H))
  ensures ((dir.e? || dir.w?) ==> ((res.y == start.y) && (res.h == start.h)))
  ensures ((dir.n? || dir.s?) ==> ((res.x == start.x) && (res.w == start.w)))
  ensures (((((dir.e? || dir.ne?) || dir.se?) || dir.n?) || dir.s?) ==> (res.x == start.x))
  ensures (((((dir.s? || dir.se?) || dir.sw?) || dir.e?) || dir.w?) ==> (res.y == start.y))
  ensures (((dir.w? || dir.nw?) || dir.sw?) ==> ((res.x + res.w) == (start.x + start.w)))
  ensures (((dir.n? || dir.ne?) || dir.nw?) ==> ((res.y + res.h) == (start.y + start.h)))
{
  var rdx := dx;
  var rdy := dy;
  var x := start.x;
  var y := start.y;
  var w := start.w;
  var h := start.h;
  if ((dir.e? || dir.ne?) || dir.se?) {
    w := MathMax(MIN_W, (start.w + rdx));
  }
  if ((dir.s? || dir.se?) || dir.sw?) {
    h := MathMax(MIN_H, (start.h + rdy));
  }
  if ((dir.w? || dir.nw?) || dir.sw?) {
    w := MathMax(MIN_W, (start.w - rdx));
    x := ((start.x + start.w) - w);
  }
  if ((dir.n? || dir.ne?) || dir.nw?) {
    h := MathMax(MIN_H, (start.h - rdy));
    y := ((start.y + start.h) - h);
  }
  return Rect(x, y, w, h);
}
