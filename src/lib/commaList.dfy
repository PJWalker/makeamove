// Generated by lsc from commaList.ts

function commaFree(s: string): bool
{
  (firstComma(s) < 0)
}

function firstComma(s: string): int
  decreases |s|
{
  if (|s| == 0) then
    -1
  else
    if ([s[0]] == ",") then
      0
    else
      var rest := firstComma(s[1..]);
      if (rest < 0) then
        -1
      else
        (rest + 1)
}

lemma firstComma_ensures(s: string)
  ensures (firstComma(s) >= -1)
  ensures (firstComma(s) < |s|)
  ensures ((firstComma(s) >= 0) ==> ([s[firstComma(s)]] == ","))
  ensures forall k: nat :: ((k < |s|) ==> ((firstComma(s) < 0) || (k < firstComma(s))) ==> ([s[k]] != ","))
  decreases |s|
{
  if |s| > 0 && [s[0]] != "," {
    firstComma_ensures(s[1..]);
    forall k: nat | k < |s| && (firstComma(s) < 0 || k < firstComma(s))
      ensures [s[k]] != ","
    {
      if k > 0 {
        assert s[k] == s[1..][k - 1];
      }
    }
  }
}

lemma FirstCommaAfter(a: string, b: string)
  requires commaFree(a)
  ensures firstComma((a + ",") + b) == |a|
  decreases |a|
{
  var s := (a + ",") + b;
  if |a| == 0 {
    assert s[0] == ',';
    assert [s[0]] == ",";
  } else {
    firstComma_ensures(a);
    assert [a[0]] != ",";
    assert s[0] == a[0];
    assert s[1..] == (a[1..] + ",") + b;
    assert firstComma(a[1..]) < 0;
    FirstCommaAfter(a[1..], b);
  }
}

function splitCommas(s: string): seq<string>
  decreases |s|
{
  var at := firstComma(s);
  firstComma_ensures(s);
  if (at < 0) then
    [s]
  else
    ([s[0..at]] + splitCommas(s[(at + 1)..]))
}

lemma splitCommas_ensures(s: string)
  ensures (|splitCommas(s)| > 0)
  ensures (joinCommas(splitCommas(s)) == s)
  decreases |s|
{
  var at := firstComma(s);
  firstComma_ensures(s);
  if at >= 0 {
    var rest := s[(at + 1)..];
    splitCommas_ensures(rest);
    var parts := [s[0..at]] + splitCommas(rest);
    assert parts[1..] == splitCommas(rest);
    assert [s[at]] == ",";
    assert s == (s[0..at] + ",") + rest;
  }
}

function joinCommas(entries: seq<string>): string
  decreases |entries|
{
  if (|entries| == 0) then
    ""
  else
    if (|entries| == 1) then
      entries[0]
    else
      ((("" + entries[0]) + ",") + joinCommas(entries[1..]))
}

lemma joinCommas_ensures(entries: seq<string>)
  ensures ((|entries| > 0) ==> (forall k: nat :: ((k < |entries|) ==> commaFree(entries[k]))) ==> (splitCommas(joinCommas(entries)) == entries))
  decreases |entries|
{
  if |entries| > 0 && (forall k: nat :: ((k < |entries|) ==> commaFree(entries[k]))) {
    if |entries| == 1 {
      assert commaFree(entries[0]);
    } else {
      var tail := entries[1..];
      assert forall k: nat :: k < |tail| ==> commaFree(tail[k]) by {
        forall k: nat | k < |tail| ensures commaFree(tail[k]) { assert tail[k] == entries[k + 1]; }
      }
      joinCommas_ensures(tail);
      var j := joinCommas(tail);
      var s := (entries[0] + ",") + j;
      assert joinCommas(entries) == s by { assert "" + entries[0] == entries[0]; }
      assert commaFree(entries[0]);
      FirstCommaAfter(entries[0], j);
      assert s[0..|entries[0]|] == entries[0];
      assert s[(|entries[0]| + 1)..] == j;
      assert entries == [entries[0]] + tail;
    }
  }
}
