// Generated by lsc from hlc.ts

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype Hlc = Hlc(wall: int, counter: int, node: string)

function isLater(a: Hlc, b: Hlc): bool
{
  ((a.wall > b.wall) || ((a.wall == b.wall) && (a.counter > b.counter)))
}

function ticked(last: Hlc, now: int): Hlc
  requires (last.counter >= 0)
{
  if (now > last.wall) then
    Hlc(now, 0, last.node)
  else
    Hlc(last.wall, (last.counter + 1), last.node)
}

lemma ticked_ensures(last: Hlc, now: int)
  requires (last.counter >= 0)
  ensures isLater(ticked(last, now), last)
  ensures (ticked(last, now).wall >= now)
  ensures (ticked(last, now).counter >= 0)
  ensures (ticked(last, now).node == last.node)
{
}

method received(last: Hlc, remote: Hlc, now: int) returns (res: Hlc)
  requires (last.counter >= 0)
  requires (remote.counter >= 0)
  ensures isLater(res, last)
  ensures isLater(res, remote)
  ensures (res.wall >= now)
  ensures (res.counter >= 0)
  ensures (res.node == last.node)
{
  var wall := MathMax(MathMax(now, last.wall), remote.wall);
  var counter := 0;
  if ((wall == last.wall) && (wall == remote.wall)) {
    counter := (MathMax(last.counter, remote.counter) + 1);
  } else if (wall == last.wall) {
    counter := (last.counter + 1);
  } else if (wall == remote.wall) {
    counter := (remote.counter + 1);
  }
  return Hlc(wall, counter, last.node);
}
