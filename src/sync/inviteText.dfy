// Generated by lsc from inviteText.ts

datatype InviteParts = InviteParts(found: bool, campaignId: string, roomKey: string)

function isIdCode(c: int): bool
{
  (((c >= DIGIT_0) && (c <= DIGIT_9)) || ((c >= LOWER_A) && (c <= LOWER_Z)))
}

function isKeyCode(c: int): bool
{
  (((isIdCode(c) || ((c >= UPPER_A) && (c <= UPPER_Z))) || (c == UNDERSCORE)) || (c == HYPHEN))
}

function isSpaceCode(c: int): bool
{
  ((c == SPACE) || ((c >= TAB) && (c <= CARRIAGE_RETURN)))
}

function idText(s: string): bool
  decreases |s|
{
  ((|s| == 0) || (isIdCode((s[0] as int)) && idText(s[1..])))
}

function keyText(s: string): bool
  decreases |s|
{
  ((|s| == 0) || (isKeyCode((s[0] as int)) && keyText(s[1..])))
}

function spaceEnd(s: string, end: int): int
  requires (0 <= end)
  requires (end <= |s|)
  decreases end
{
  if ((end > 0) && isSpaceCode((s[(end - 1)] as int))) then
    spaceEnd(s, (end - 1))
  else
    end
}

lemma spaceEnd_ensures(s: string, end: int)
  requires (0 <= end)
  requires (end <= |s|)
  ensures (0 <= spaceEnd(s, end))
  ensures (spaceEnd(s, end) <= end)
  decreases end
{
  if end > 0 && isSpaceCode(s[end - 1] as int) {
    spaceEnd_ensures(s, end - 1);
  }
}

function keyFrom(s: string, end: int): int
  requires (0 <= end)
  requires (end <= |s|)
  decreases end
{
  if ((end > 0) && isKeyCode((s[(end - 1)] as int))) then
    keyFrom(s, (end - 1))
  else
    end
}

lemma keyFrom_ensures(s: string, end: int)
  requires (0 <= end)
  requires (end <= |s|)
  ensures (0 <= keyFrom(s, end))
  ensures (keyFrom(s, end) <= end)
  decreases end
{
  if end > 0 && isKeyCode(s[end - 1] as int) {
    keyFrom_ensures(s, end - 1);
  }
}

function idFrom(s: string, end: int): int
  requires (0 <= end)
  requires (end <= |s|)
  decreases end
{
  if ((end > 0) && isIdCode((s[(end - 1)] as int))) then
    idFrom(s, (end - 1))
  else
    end
}

lemma idFrom_ensures(s: string, end: int)
  requires (0 <= end)
  requires (end <= |s|)
  ensures (0 <= idFrom(s, end))
  ensures (idFrom(s, end) <= end)
  decreases end
{
  if end > 0 && isIdCode(s[end - 1] as int) {
    idFrom_ensures(s, end - 1);
  }
}

lemma KeyTextSnoc(t: string, c: char)
  requires keyText(t) && isKeyCode(c as int)
  ensures keyText(t + [c])
  decreases |t|
{
  if |t| > 0 {
    assert (t + [c])[1..] == t[1..] + [c];
    KeyTextSnoc(t[1..], c);
  } else {
    assert (t + [c])[1..] == "";
  }
}

lemma IdTextSnoc(t: string, c: char)
  requires idText(t) && isIdCode(c as int)
  ensures idText(t + [c])
  decreases |t|
{
  if |t| > 0 {
    assert (t + [c])[1..] == t[1..] + [c];
    IdTextSnoc(t[1..], c);
  } else {
    assert (t + [c])[1..] == "";
  }
}

lemma KeyRun(s: string, end: int)
  requires 0 <= end <= |s|
  ensures 0 <= keyFrom(s, end) <= end && keyText(s[keyFrom(s, end)..end])
  decreases end
{
  keyFrom_ensures(s, end);
  if end > 0 && isKeyCode(s[end - 1] as int) {
    KeyRun(s, end - 1);
    var a := keyFrom(s, end - 1);
    KeyTextSnoc(s[a..end - 1], s[end - 1]);
    assert s[a..end] == s[a..end - 1] + [s[end - 1]];
  } else {
    assert s[end..end] == "";
  }
}

lemma IdRun(s: string, end: int)
  requires 0 <= end <= |s|
  ensures 0 <= idFrom(s, end) <= end && idText(s[idFrom(s, end)..end])
  decreases end
{
  idFrom_ensures(s, end);
  if end > 0 && isIdCode(s[end - 1] as int) {
    IdRun(s, end - 1);
    var a := idFrom(s, end - 1);
    IdTextSnoc(s[a..end - 1], s[end - 1]);
    assert s[a..end] == s[a..end - 1] + [s[end - 1]];
  } else {
    assert s[end..end] == "";
  }
}

lemma KeyTextAll(t: string)
  requires keyText(t)
  ensures forall i :: 0 <= i < |t| ==> isKeyCode(t[i] as int)
  decreases |t|
{
  if |t| > 0 {
    KeyTextAll(t[1..]);
    forall i | 0 < i < |t| ensures isKeyCode(t[i] as int) { assert t[i] == t[1..][i - 1]; }
  }
}

lemma IdTextAll(t: string)
  requires idText(t)
  ensures forall i :: 0 <= i < |t| ==> isIdCode(t[i] as int)
  decreases |t|
{
  if |t| > 0 {
    IdTextAll(t[1..]);
    forall i | 0 < i < |t| ensures isIdCode(t[i] as int) { assert t[i] == t[1..][i - 1]; }
  }
}

lemma KeyFromRun(s: string, lo: int, end: int)
  requires 0 <= lo <= end <= |s|
  requires forall i :: lo <= i < end ==> isKeyCode(s[i] as int)
  requires lo == 0 || !isKeyCode(s[lo - 1] as int)
  ensures keyFrom(s, end) == lo
  decreases end - lo
{
  if end > lo {
    KeyFromRun(s, lo, end - 1);
  }
}

lemma IdFromRun(s: string, lo: int, end: int)
  requires 0 <= lo <= end <= |s|
  requires forall i :: lo <= i < end ==> isIdCode(s[i] as int)
  requires lo == 0 || !isIdCode(s[lo - 1] as int)
  ensures idFrom(s, end) == lo
  decreases end - lo
{
  if end > lo {
    IdFromRun(s, lo, end - 1);
  }
}

function readInvite(text: string): InviteParts
{
  var none := InviteParts(false, "", "");
  var end := spaceEnd(text, |text|);
  spaceEnd_ensures(text, |text|);
  var keyAt := keyFrom(text, end);
  keyFrom_ensures(text, end);
  var dot := (keyAt - 1);
  if (((dot < 0) || ([text[dot]] != ".")) || ((end - keyAt) < MIN_KEY)) then
    none
  else
    var idAt := idFrom(text, dot);
    idFrom_ensures(text, dot);
    if (((idAt == dot) || (idAt < |JOIN|)) || (text[(idAt - |JOIN|)..idAt] != JOIN)) then
      none
    else
      InviteParts(true, text[idAt..dot], text[keyAt..end])
}

lemma readInvite_ensures(text: string)
  ensures (readInvite(text).found ==> ((|readInvite(text).campaignId| > 0) && idText(readInvite(text).campaignId)))
  ensures (readInvite(text).found ==> ((|readInvite(text).roomKey| >= MIN_KEY) && keyText(readInvite(text).roomKey)))
{
  var end := spaceEnd(text, |text|);
  spaceEnd_ensures(text, |text|);
  KeyRun(text, end);
  var keyAt := keyFrom(text, end);
  var dot := keyAt - 1;
  if dot >= 0 && [text[dot]] == "." && end - keyAt >= MIN_KEY {
    IdRun(text, dot);
  }
}

function inviteText(page: string, campaignId: string, roomKey: string): string
{
  ((((("" + page) + "#join=") + campaignId) + ".") + roomKey)
}

lemma inviteText_ensures(page: string, campaignId: string, roomKey: string)
  ensures ((|campaignId| > 0) ==> idText(campaignId) ==> (|roomKey| >= MIN_KEY) ==> keyText(roomKey) ==> ((readInvite(inviteText(page, campaignId, roomKey)).found && (readInvite(inviteText(page, campaignId, roomKey)).campaignId == campaignId)) && (readInvite(inviteText(page, campaignId, roomKey)).roomKey == roomKey)))
{
  if |campaignId| > 0 && idText(campaignId) && |roomKey| >= MIN_KEY && keyText(roomKey) {
    var t := inviteText(page, campaignId, roomKey);
    var B := page + "#join=";
    var A := (B + campaignId) + ".";
    assert "" + page == page;
    assert t == A + roomKey;
    KeyTextAll(roomKey);
    IdTextAll(campaignId);
    assert t[|t| - 1] == roomKey[|roomKey| - 1];
    assert spaceEnd(t, |t|) == |t|;
    forall i | |A| <= i < |t| ensures isKeyCode(t[i] as int) { assert t[i] == roomKey[i - |A|]; }
    assert t[|A| - 1] == '.';
    KeyFromRun(t, |A|, |t|);
    var dot := |A| - 1;
    assert [t[dot]] == ".";
    forall i | |B| <= i < dot ensures isIdCode(t[i] as int) { assert t[i] == campaignId[i - |B|]; }
    assert t[|B| - 1] == '=';
    IdFromRun(t, |B|, dot);
    assert t[|B| - |JOIN|..|B|] == JOIN;
    assert t[|B|..dot] == campaignId;
    assert t[|A|..|t|] == roomKey;
  }
}

const MIN_KEY: int := 16

const DIGIT_0: int := 48

const DIGIT_9: int := 57

const LOWER_A: int := 97

const LOWER_Z: int := 122

const UPPER_A: int := 65

const UPPER_Z: int := 90

const UNDERSCORE: int := 95

const HYPHEN: int := 45

const SPACE: int := 32

const TAB: int := 9

const CARRIAGE_RETURN: int := 13

const JOIN: string := "join="
