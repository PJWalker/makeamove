function readInvite(text: string): InviteParts
{
  var none := InviteParts(false, "", "");
  var end := spaceEnd(text, |text|);
  var keyAt := keyFrom(text, end);
  var dot := (keyAt - 1);
  if (((dot < 0) || ([text[dot]] != ".")) || ((end - keyAt) < MIN_KEY)) then
    none
  else
    var idAt := idFrom(text, dot);
    if (((idAt == dot) || (idAt < |JOIN|)) || (text[(idAt - |JOIN|)..idAt] != JOIN)) then
      none
    else
      InviteParts(true, text[idAt..dot], text[keyAt..end])
}

