}

function stepForward(count: int, at: Turn): Turn
  requires (count > 0)
  requires (at.index >= -1)
  requires (at.index < count)
{
  var wraps := (at.index == (count - 1));
  if wraps then
    Turn(0, (at.round + 1))
  else
    Turn((if (at.index < 0) then 0 else (at.index + 1)), at.round)
}

lemma stepForward_ensures(count: int, at: Turn)
  requires (count > 0)
  requires (at.index >= -1)
  requires (at.index < count)
  ensures (stepForward(count, at).index >= 0)
