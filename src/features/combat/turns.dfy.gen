  ensures ((at.index < 0) ==> (stepForward(count, at).index == 0))
  ensures ((at.index >= 0) ==> (at.round >= 1) ==> ((stepBack(count, stepForward(count, at)).index == at.index) && (stepBack(count, stepForward(count, at)).round == at.round)))
