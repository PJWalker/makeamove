datatype Turn = Turn(index: int, round: int)

function stepBack(count: int, at: Turn): Turn
  requires (count > 0)
  requires (at.index >= -1)
  requires (at.index < count)
{
  if ((at.index <= 0) && (at.round <= 1)) then
    at
  else
    if (at.index <= 0) then
      Turn((count - 1), (at.round - 1))
    else
      Turn((at.index - 1), at.round)
}

lemma stepBack_ensures(count: int, at: Turn)
  requires (count > 0)
  requires (at.index >= -1)
  requires (at.index < count)
  ensures (stepBack(count, at).index >= -1)
  ensures (stepBack(count, at).index < count)
  ensures ((at.index <= 0) ==> (at.round <= 1) ==> ((stepBack(count, at).index == at.index) && (stepBack(count, at).round == at.round)))
  ensures ((at.index > 0) ==> ((stepBack(count, at).index == (at.index - 1)) && (stepBack(count, at).round == at.round)))
