function passedOn(count: int, index: int): int
  requires (count > 0)
  requires (index >= 0)
  requires (index < count)
{
  if (count == 1) then
    -1
  else
    if (index == (count - 1)) then
      0
    else
      (index + 1)
}

lemma passedOn_ensures(count: int, index: int)
