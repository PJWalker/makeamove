function SeqFindIndex<T>(s: seq<T>, p: T -> bool): int
  ensures -1 <= SeqFindIndex(s, p) < |s|
  ensures SeqFindIndex(s, p) >= 0 ==> p(s[SeqFindIndex(s, p)])
  ensures SeqFindIndex(s, p) >= 0 ==>
    (forall i: nat :: i < SeqFindIndex(s, p) ==> !p(s[i]))
  ensures SeqFindIndex(s, p) == -1 ==> (forall i: nat :: i < |s| ==> !p(s[i]))
{
  SeqFindIndexFrom(s, p, 0)
}

function SeqFindIndexFrom<T>(s: seq<T>, p: T -> bool, from: nat): int
  requires from <= |s|
  ensures -1 <= SeqFindIndexFrom(s, p, from) < |s|
  ensures SeqFindIndexFrom(s, p, from) >= 0 ==>
    from <= SeqFindIndexFrom(s, p, from) && p(s[SeqFindIndexFrom(s, p, from)])
  ensures SeqFindIndexFrom(s, p, from) >= 0 ==>
    (forall i: nat :: from <= i < SeqFindIndexFrom(s, p, from) ==> !p(s[i]))
  ensures SeqFindIndexFrom(s, p, from) == -1 ==>
    (forall i: nat :: from <= i < |s| ==> !p(s[i]))
  decreases |s| - from
{
  if from >= |s| then -1
  else if p(s[from]) then from as int
  else SeqFindIndexFrom(s, p, from + 1)
}

datatype Cost = Cost(resource: string, by_: int)

datatype Spend = Spend(id: string, by_: int)

function totalFor(costs: seq<Cost>, resource: string): int
  decreases |costs|
{
  if (|costs| == 0) then
    0
  else
    var last := costs[(|costs| - 1)];
    (totalFor(costs[0..|costs|-1], resource) + (if (last.resource == resource) then last.by_ else 0))
}

function held(resources: map<string, int>, id: string): int
{
  if (id in resources) then
    var i_oc0_val := resources[id];
    i_oc0_val
  else
    0
}

function canAfford(resources: map<string, int>, spends: seq<Spend>): bool
{
  Std.Collections.Seq.All(spends, (s: Spend) => ((held(resources, s.id) + s.by_) >= 0))
}

lemma canAfford_ensures(resources: map<string, int>, spends: seq<Spend>)
  ensures (canAfford(resources, spends) <==> forall i: int :: ((0 <= i) ==> (i < |spends|) ==> ((held(resources, spends[i].id) + spends[i].by_) >= 0)))
{
}

lemma TotalStep(costs: seq<Cost>, i: int, r: string)
  requires 0 <= i < |costs|
  ensures totalFor(costs[0..i+1], r) == totalFor(costs[0..i], r) + (if costs[i].resource == r then costs[i].by_ else 0)
{
  assert costs[0..i+1][0..i] == costs[0..i];
}

method mergeCosts(costs: seq<Cost>) returns (res: seq<Spend>)
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> (res[i].by_ != 0))
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> (res[i].by_ == totalFor(costs, res[i].id)))
  ensures forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |res|) ==> (res[i].id != res[j].id))
  ensures forall r :: ((totalFor(costs, r) != 0) ==> exists j: int :: (((0 <= j) && (j < |res|)) && (res[j].id == r)))
{
  var totals: seq<Spend> := [];
  var i := 0;
  while (i < |costs|)
    invariant (0 <= i)
    invariant (i <= |costs|)
    invariant forall k: int :: ((0 <= k) ==> (k < |totals|) ==> (totals[k].by_ == totalFor(costs[0..i], totals[k].id)))
    invariant forall k: int, j: int :: ((0 <= k) ==> (k < j) ==> (j < |totals|) ==> (totals[k].id != totals[j].id))
    invariant forall r :: ((totalFor(costs[0..i], r) != 0) ==> exists j: int :: (((0 <= j) && (j < |totals|)) && (totals[j].id == r)))
    decreases (|costs| - i)
  {
    var cost := costs[i];
    forall r: string
      ensures totalFor(costs[0..i+1], r) == totalFor(costs[0..i], r) + (if cost.resource == r then cost.by_ else 0)
    {
      TotalStep(costs, i, r);
    }
    var at := SeqFindIndex(totals, (t: Spend) => (t.id == cost.resource));
    ghost var before := totals;
    totals := (if (at == -1) then (totals + [Spend(cost.resource, cost.by_)]) else totals[at := Spend(cost.resource, (totals[at].by_ + cost.by_))]);
    forall r | totalFor(costs[0..i+1], r) != 0
      ensures exists j: int :: 0 <= j < |totals| && totals[j].id == r
    {
      if r == cost.resource {
        if at == -1 {
          assert totals[|totals| - 1].id == r;
        } else {
          assert totals[at].id == r;
        }
      } else {
        var j :| 0 <= j < |before| && before[j].id == r;
        assert totals[j].id == r;
      }
    }
    i := (i + 1);
  }
  assert costs[0..i] == costs;
  var merged: seq<Spend> := [];
  var k := 0;
  while (k < |totals|)
    invariant (0 <= k)
    invariant (k <= |totals|)
    invariant forall m: int :: ((0 <= m) ==> (m < |merged|) ==> (merged[m].by_ != 0))
    invariant forall m: int :: ((0 <= m) ==> (m < |merged|) ==> (merged[m].by_ == totalFor(costs, merged[m].id)))
    invariant forall m: int, j: int :: ((0 <= m) ==> (m < j) ==> (j < |merged|) ==> (merged[m].id != merged[j].id))
    invariant forall m: int, j: int :: ((0 <= m) ==> (m < |merged|) ==> (k <= j) ==> (j < |totals|) ==> (merged[m].id != totals[j].id))
    invariant forall j: int :: ((0 <= j) ==> (j < k) ==> (totals[j].by_ != 0) ==> exists m: int :: (((0 <= m) && (m < |merged|)) && (merged[m].id == totals[j].id)))
    decreases (|totals| - k)
  {
    var total := totals[k];
    ghost var before := merged;
    if (total.by_ != 0) {
      merged := (merged + [total]);
    }
    forall j | 0 <= j < k + 1 && totals[j].by_ != 0
      ensures exists m: int :: 0 <= m < |merged| && merged[m].id == totals[j].id
    {
      if j == k {
        assert merged[|merged| - 1] == total;
      } else {
        var m :| 0 <= m < |before| && before[m].id == totals[j].id;
        assert merged[m] == before[m];
      }
    }
    k := (k + 1);
  }
  return merged;
}
