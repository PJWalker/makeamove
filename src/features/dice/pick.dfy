// Generated by lsc from pick.ts

function MathMin(a: int, b: int): int { if a <= b then a else b }

datatype Ranking = Ranking(values: seq<int>, high: bool)

datatype RolledDie = RolledDie(value: int, exploded: bool)

datatype DiceCount = DiceCount(count: int, sides: int, explode: bool)

function outranks(r: Ranking, a: int, b: int): bool
  requires (0 <= a)
  requires (a < |r.values|)
  requires (0 <= b)
  requires (b < |r.values|)
{
  if (r.values[a] != r.values[b]) then
    if r.high then
      (r.values[a] > r.values[b])
    else
      (r.values[a] < r.values[b])
  else
    if r.high then
      (a > b)
    else
      (a < b)
}

const MAX_EXPLOSIONS: int := 50

lemma RangeSize(n: nat)
  ensures |set j: int | 0 <= j < n| == n
{
  if n > 0 {
    RangeSize(n - 1);
    assert (set j: int | 0 <= j < n) == (set j: int | 0 <= j < n - 1) + {n - 1};
  }
}

lemma SubsetSize(a: set<int>, b: set<int>)
  requires a <= b
  ensures |a| <= |b|
{
  assert b == a + (b - a);
}

method pick(r: Ranking, n: int) returns (res: set<int>)
  requires (n >= 0)
  ensures (|res| == MathMin(n, |r.values|))
  ensures forall i: int :: ((i in res) ==> ((0 <= i) && (i < |r.values|)))
  ensures forall a: int, b: int :: ((a in res) ==> !((b in res)) ==> (0 <= b) ==> (b < |r.values|) ==> outranks(r, a, b))
{
  var chosen: set<int> := {};
  var target := MathMin(n, |r.values|);
  var round := 0;
  while (round < target)
    invariant (0 <= round)
    invariant (round <= target)
    invariant (|chosen| == round)
    invariant forall i: int :: ((i in chosen) ==> ((0 <= i) && (i < |r.values|)))
    invariant forall a: int, b: int :: ((a in chosen) ==> !((b in chosen)) ==> (0 <= b) ==> (b < |r.values|) ==> outranks(r, a, b))
    decreases (target - round)
  {
    var best := -1;
    var i := 0;
    while (i < |r.values|)
      invariant (0 <= i)
      invariant (i <= |r.values|)
      invariant (-1 <= best)
      invariant (best < i)
      invariant ((best == -1) ==> forall j: int :: ((0 <= j) ==> (j < i) ==> (j in chosen)))
      invariant ((best != -1) ==> !((best in chosen)))
      invariant ((best != -1) ==> forall j: int :: ((0 <= j) ==> (j < i) ==> (j != best) ==> !((j in chosen)) ==> outranks(r, best, j)))
      decreases (|r.values| - i)
    {
      var i_branch1 := !((i in chosen));
      if i_branch1 {
        var i_branch0 := (best == -1);
        if !(i_branch0) {
          var i_t0 := outranks(r, i, best);
          i_branch0 := i_t0;
        }
        i_branch1 := i_branch0;
      }
      if i_branch1 {
        best := i;
      }
      i := (i + 1);
    }
    if best == -1 {
      RangeSize(|r.values|);
      SubsetSize(set j: int | 0 <= j < |r.values|, chosen);
      assert false;
    }
    chosen := (chosen + {best});
    round := (round + 1);
  }
  return chosen;
}

method rollDice(term: DiceCount, die: (int) -> int) returns (res: seq<RolledDie>)
  requires (term.count >= 0)
  ensures (term.count <= |res|)
  ensures (|res| <= (term.count + MAX_EXPLOSIONS))
{
  var count := term.count;
  var sides := term.sides;
  var explode := term.explode;
  var rolled: seq<RolledDie> := [];
  var explosions := 0;
  var k := 0;
  while (k < count)
    invariant (0 <= k)
    invariant (k <= count)
    invariant (0 <= explosions)
    invariant (explosions <= MAX_EXPLOSIONS)
    invariant (|rolled| == (k + explosions))
    decreases (count - k)
  {
    var value := die(sides);
    rolled := (rolled + [RolledDie(value, false)]);
    if explode {
      while ((value == sides) && (explosions < MAX_EXPLOSIONS))
        invariant (0 <= explosions)
        invariant (explosions <= MAX_EXPLOSIONS)
        invariant (|rolled| == ((k + 1) + explosions))
        decreases (MAX_EXPLOSIONS - explosions)
      {
        explosions := (explosions + 1);
        value := die(sides);
        rolled := (rolled + [RolledDie(value, true)]);
      }
    }
    k := (k + 1);
  }
  return rolled;
}
