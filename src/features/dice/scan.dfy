function StringIndexOf(s: string, sub: string): int
  ensures StringIndexOf(s, sub) == -1
       || (0 <= StringIndexOf(s, sub) <= |s| - |sub| && s[StringIndexOf(s, sub)..StringIndexOf(s, sub) + |sub|] == sub)
{
  StringIndexOfFrom(s, sub, 0)
}

function StringIndexOfFrom(s: string, sub: string, from: int): int
  ensures StringIndexOfFrom(s, sub, from) == -1
       || (0 <= StringIndexOfFrom(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFrom(s, sub, from)..StringIndexOfFrom(s, sub, from) + |sub|] == sub
           && StringIndexOfFrom(s, sub, from) >= from)
{
  StringIndexOfFromN(s, sub, if from < 0 then 0 else from)
}

function StringIndexOfFromN(s: string, sub: string, from: nat): int
  decreases |s| - from
  ensures StringIndexOfFromN(s, sub, from) == -1
       || (from <= StringIndexOfFromN(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFromN(s, sub, from)..StringIndexOfFromN(s, sub, from) + |sub|] == sub)
{
  if from + |sub| > |s| then -1
  else if s[from..from + |sub|] == sub then from as int
  else StringIndexOfFromN(s, sub, from + 1)
}

function StringSearchPosition(s: string, position: int): nat
  ensures StringSearchPosition(s, position) <= |s|
{
  if position < 0 then 0 else if position > |s| then |s| else position
}

function NatToString(n: nat): string
  decreases n
{
  var digit := ('0' as int + n % 10) as char;
  if n < 10 then [digit]
  else NatToString(n / 10) + [digit]
}

function IntToString(n: int): string
{
  if n < 0 then "-" + NatToString(-n) else NatToString(n)
}

function MathMax(a: int, b: int): int { if a >= b then a else b }

datatype PickOp = all | dh | dl | kh | kl

datatype Scanned = Scanned(dice: bool, sign: int, count: int, sides: int, value: int, pick: PickOp, pickN: int, explode: bool, label_: string)

datatype PickFound = PickFound(length: int, op: PickOp)

datatype Scan = Scan(terms: seq<Scanned>, error: string)

function rollable(t: Scanned): bool
{
  (((t.sign == 1) || (t.sign == -1)) && (if t.dice then ((((((t.count >= 1) && (t.count <= MAX_DICE)) && (t.sides >= 1)) && (t.sides <= MAX_SIDES)) && (!(t.explode) || (t.sides > 1))) && (t.pickN >= 0)) else (((t.value >= 0) && t.pick.all?) && !(t.explode))))
}

function isSpaceAt(s: string, i: int): bool
  requires (0 <= i)
  requires (i < |s|)
{
  var c := (s[i] as int);
  ((c == SPACE) || ((c >= TAB) && (c <= CARRIAGE_RETURN)))
}

function isDigitAt(s: string, i: int): bool
  requires (0 <= i)
  requires (i < |s|)
{
  var c := (s[i] as int);
  ((c >= DIGIT_0) && (c <= DIGIT_9))
}

function lowerAt(s: string, i: int): int
  requires (0 <= i)
{
  if (i >= |s|) then
    -1
  else
    var c := (s[i] as int);
    if ((c >= UPPER_A) && (c <= UPPER_Z)) then
      (c + CASE_GAP)
    else
      c
}

function spaceEnd(s: string, i: int): int
  requires (0 <= i)
  requires (i <= |s|)
  decreases (|s| - i)
{
  if ((i < |s|) && isSpaceAt(s, i)) then
    spaceEnd(s, (i + 1))
  else
    i
}

lemma spaceEnd_ensures(s: string, i: int)
  requires (0 <= i)
  requires (i <= |s|)
  ensures (i <= spaceEnd(s, i))
  ensures (spaceEnd(s, i) <= |s|)
  decreases |s| - i
{
  if i < |s| && isSpaceAt(s, i) { spaceEnd_ensures(s, i + 1); }
}

function spaceStart(s: string, end: int): int
  requires (0 <= end)
  requires (end <= |s|)
  decreases end
{
  if ((end > 0) && isSpaceAt(s, (end - 1))) then
    spaceStart(s, (end - 1))
  else
    end
}

lemma spaceStart_ensures(s: string, end: int)
  requires (0 <= end)
  requires (end <= |s|)
  ensures (0 <= spaceStart(s, end))
  ensures (spaceStart(s, end) <= end)
  decreases end
{
  if end > 0 && isSpaceAt(s, end - 1) { spaceStart_ensures(s, end - 1); }
}

function digitsEnd(s: string, i: int): int
  requires (0 <= i)
  requires (i <= |s|)
  decreases (|s| - i)
{
  if ((i < |s|) && isDigitAt(s, i)) then
    digitsEnd(s, (i + 1))
  else
    i
}

lemma digitsEnd_ensures(s: string, i: int)
  requires (0 <= i)
  requires (i <= |s|)
  ensures (i <= digitsEnd(s, i))
  ensures (digitsEnd(s, i) <= |s|)
  decreases |s| - i
{
  if i < |s| && isDigitAt(s, i) { digitsEnd_ensures(s, i + 1); }
}

function numberOf(s: string, i: int, end: int): int
  requires (0 <= i)
  requires (i <= end)
  requires (end <= |s|)
  decreases (end - i)
{
  if (end <= i) then
    0
  else
    var digit := (if isDigitAt(s, (end - 1)) then ((s[(end - 1)] as int) - DIGIT_0) else 0);
    ((numberOf(s, i, (end - 1)) * TEN) + digit)
}

lemma numberOf_ensures(s: string, i: int, end: int)
  requires (0 <= i)
  requires (i <= end)
  requires (end <= |s|)
  ensures (numberOf(s, i, end) >= 0)
  decreases end - i
{
  if end > i { numberOf_ensures(s, i, end - 1); }
}

function trimmed(s: string): string
{
  var start := spaceEnd(s, 0);
  spaceEnd_ensures(s, 0);
  spaceStart_ensures(s, |s|);
  s[start..MathMax(start, spaceStart(s, |s|))]
}

function pickAt(s: string, i: int): PickFound
  requires (0 <= i)
  requires (i <= |s|)
{
  var none := PickFound(0, PickOp.all);
  var c := lowerAt(s, i);
  var next := lowerAt(s, (i + 1));
  var twoDigits := (((i + PAIR) < |s|) && isDigitAt(s, (i + PAIR)));
  var oneDigit := (((i + 1) < |s|) && isDigitAt(s, (i + 1)));
  if ((((c == K) || (c == D)) && ((next == H) || (next == L))) && twoDigits) then
    var high := (next == H);
    if (c == K) then
      PickFound(2, (if high then PickOp.kh else PickOp.kl))
    else
      PickFound(2, (if high then PickOp.dh else PickOp.dl))
  else
    if (((c == K) || (c == B)) && oneDigit) then
      PickFound(1, PickOp.kh)
    else
      if ((c == W) && oneDigit) then
        PickFound(1, PickOp.kl)
      else
        none
}

lemma pickAt_ensures(s: string, i: int)
  requires (0 <= i)
  requires (i <= |s|)
  ensures (pickAt(s, i).length >= 0)
  ensures ((i + pickAt(s, i).length) <= |s|)
  ensures ((pickAt(s, i).length > 0) ==> (((!pickAt(s, i).op.all?) && ((i + pickAt(s, i).length) < |s|)) && isDigitAt(s, (i + pickAt(s, i).length))))
{
}

const MAX_DICE: int := 1000

const MAX_SIDES: int := 1000

const PERCENT_SIDES: int := 100

const DIGIT_0: int := 48

const DIGIT_9: int := 57

const SPACE: int := 32

const TAB: int := 9

const CARRIAGE_RETURN: int := 13

const CASE_GAP: int := 32

const UPPER_A: int := 65

const UPPER_Z: int := 90

const D: int := 100

const K: int := 107

const B: int := 98

const W: int := 119

const H: int := 104

const L: int := 108

const TEN: int := 10

const PAIR: int := 2

method scan(formula: string) returns (res: Scan)
  ensures ((res.error == "") ==> forall k: nat :: ((k < |res.terms|) ==> rollable(res.terms[k])))
{
  var i_t0 := trimmed(formula);
  var source := i_t0;
  if (|source| == 0) {
    return Scan([], "Enter some dice, like 2d6+1.");
  }
  var terms: seq<Scanned> := [];
  spaceEnd_ensures(source, 0);
  var i_t1 := spaceEnd(source, 0);
  var index := i_t1;
  while (index < |source|)
    invariant (0 <= index)
    invariant (index <= |source|)
    invariant forall k: nat :: ((k < |terms|) ==> rollable(terms[k]))
    decreases (|source| - index)
  {
    var start := index;
    var sign := 1;
    if (([source[index]] == "+") || ([source[index]] == "-")) {
      sign := (if ([source[index]] == "-") then -1 else 1);
      spaceEnd_ensures(source, (index + 1));
      index := spaceEnd(source, (index + 1));
    } else if (|terms| > 0) {
      return Scan(terms, (("Expected + or - before “" + source[index..]) + "”."));
    }
    var numberAt := index;
    digitsEnd_ensures(source, index);
    var i_t2 := digitsEnd(source, index);
    var numberEnd := i_t2;
    var hasNumber := (numberEnd > numberAt);
    numberOf_ensures(source, numberAt, numberEnd);
    var i_t3 := numberOf(source, numberAt, numberEnd);
    var n := i_t3;
    index := numberEnd;
    var term := Scanned(false, sign, 0, 0, n, PickOp.all, 0, false, "");
    var i_t4 := lowerAt(source, index);
    if (i_t4 == D) {
      index := (index + 1);
      var sides := 0;
      if ((index < |source|) && ([source[index]] == "%")) {
        index := (index + 1);
        sides := PERCENT_SIDES;
      } else {
        digitsEnd_ensures(source, index);
        var i_t5 := digitsEnd(source, index);
        var sidesEnd := i_t5;
        if (sidesEnd == index) {
          return Scan(terms, "Dice need a number of sides, like d6.");
        }
        numberOf_ensures(source, index, sidesEnd);
        sides := numberOf(source, index, sidesEnd);
        index := sidesEnd;
      }
      var count := (if hasNumber then n else 1);
      if (count < 1) {
        return Scan(terms, "Roll at least one die.");
      }
      if (count > MAX_DICE) {
        return Scan(terms, (("That’s more than " + IntToString(MAX_DICE)) + " dice."));
      }
      if ((sides < 1) || (sides > MAX_SIDES)) {
        return Scan(terms, (("Dice can have 1 to " + IntToString(MAX_SIDES)) + " sides."));
      }
      var pick := PickOp.all;
      var pickN := 0;
      var explode := false;
      var more := true;
      while (more && (index < |source|))
        invariant (0 <= index)
        invariant (index <= |source|)
        invariant (pickN >= 0)
        invariant (!(explode) || (sides > 1))
        decreases ((|source| - index) + (if more then 1 else 0))
      {
        var i_t6 := pickAt(source, index);
        var found := i_t6;
        if (found.length > 0) {
          if (!pick.all?) {
            return Scan(terms, "Use one keep or drop per dice term.");
          }
          var digitsAt := (index + found.length);
          digitsEnd_ensures(source, digitsAt);
          var i_t7 := digitsEnd(source, digitsAt);
          var end := i_t7;
          pick := found.op;
          numberOf_ensures(source, digitsAt, end);
          pickN := numberOf(source, digitsAt, end);
          index := end;
        } else if ([source[index]] == "!") {
          index := (index + 1);
          if (sides == 1) {
            return Scan(terms, "A d1 can’t explode.");
          }
          explode := true;
        } else {
          more := false;
        }
      }
      term := Scanned(true, sign, count, sides, 0, pick, pickN, explode, "");
    } else if !(hasNumber) {
      return Scan(terms, (("Couldn’t read “" + source[start..]) + "”."));
    }
    spaceEnd_ensures(source, index);
    index := spaceEnd(source, index);
    if ((index < |source|) && ([source[index]] == "[")) {
      var close_2 := StringIndexOfFrom(source, "]", StringSearchPosition(source, index));
      if (close_2 < index) {
        return Scan(terms, "A [label] is missing its closing ].");
      }
      var i_t8 := trimmed(source[(index + 1)..close_2]);
      term := Scanned(term.dice, term.sign, term.count, term.sides, term.value, term.pick, term.pickN, term.explode, i_t8);
      index := (close_2 + 1);
    }
    terms := (terms + [term]);
    spaceEnd_ensures(source, index);
    index := spaceEnd(source, index);
    if (index <= start) {
      return Scan(terms, (("Couldn’t read “" + source[start..]) + "”."));
    }
  }
  return Scan(terms, "");
}
