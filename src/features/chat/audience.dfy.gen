// Generated by lsc from audience.ts

datatype Seen = full | hidden | masked

datatype Audience = Audience(author: string, whisper: bool, to: seq<string>, secretRoll: bool)

function seenBy(a: Audience, me: string, isGm: bool): Seen
{
  if a.whisper then
    if ((a.author == me) || (me in a.to)) then
      Seen.full
    else
      Seen.hidden
  else
    if ((a.secretRoll && !(isGm)) && (a.author != me)) then
      Seen.masked
    else
      Seen.full
}

lemma seenBy_ensures(a: Audience, me: string, isGm: bool)
  ensures (a.whisper ==> (seenBy(a, me, isGm).full? == ((a.author == me) || (me in a.to))))
  ensures (a.whisper ==> (!seenBy(a, me, isGm).masked?))
  ensures (!(a.whisper) ==> (!seenBy(a, me, isGm).hidden?))
  ensures (!(a.whisper) ==> (seenBy(a, me, isGm).masked? == ((a.secretRoll && !(isGm)) && (a.author != me))))
{
}
