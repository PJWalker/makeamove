// Generated by lsc from window.ts

function costFrom(costs: seq<int>, from: int): int
  requires (0 <= from)
  requires (from <= |costs|)
  decreases (|costs| - from)
{
  if (from >= |costs|) then
    0
  else
    (costs[from] + costFrom(costs, (from + 1)))
}

method foldCount(costs: seq<int>, budget: int) returns (res: int)
  ensures (0 <= res)
  ensures (res <= |costs|)
  ensures ((res == |costs|) || (costFrom(costs, res) <= budget))
  ensures ((res == 0) || (costFrom(costs, (res - 1)) > budget))
{
  var n := 0;
  var i_t0 := costFrom(costs, 0);
  var rest := i_t0;
  while ((n < |costs|) && (rest > budget))
    invariant (0 <= n)
    invariant (n <= |costs|)
    invariant (rest == costFrom(costs, n))
    invariant ((n == 0) || (costFrom(costs, (n - 1)) > budget))
    decreases (|costs| - n)
  {
    rest := (rest - costs[n]);
    n := (n + 1);
  }
  return n;
}
