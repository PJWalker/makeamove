// Generated by lsc from steps.ts

datatype StepKind = redo | undo

datatype Steps = Steps(undo: seq<string>, redo: seq<string>)

datatype Clearing = Clearing(undo: bool, redo: bool)

function occurrences(ids: seq<string>, id: string): int
  decreases |ids|
{
  if (|ids| == 0) then
    0
  else
    var last := ids[(|ids| - 1)];
    (occurrences(ids[0..|ids|-1], id) + (if (last == id) then 1 else 0))
}

lemma occurrences_ensures(ids: seq<string>, id: string)
  ensures (occurrences(ids, id) >= 0)
  decreases |ids|
{
  if |ids| > 0 {
    occurrences_ensures(ids[0..|ids|-1], id);
  }
}

function withoutLast(ids: seq<string>, id: string): seq<string>
  decreases |ids|
{
  if (|ids| == 0) then
    []
  else
    var last := ids[(|ids| - 1)];
    var init := ids[0..|ids|-1];
    if (last == id) then
      init
    else
      (withoutLast(init, id) + [last])
}

lemma OccurrencesSnoc(a: seq<string>, b: string, x: string)
  ensures occurrences(a + [b], x) == occurrences(a, x) + (if b == x then 1 else 0)
{
  assert (a + [b])[0..|a + [b]| - 1] == a;
}

lemma withoutLast_ensures(ids: seq<string>, id: string)
  ensures (occurrences(withoutLast(ids, id), id) == (if (occurrences(ids, id) > 0) then (occurrences(ids, id) - 1) else 0))
  ensures forall x :: ((x != id) ==> (occurrences(withoutLast(ids, id), x) == occurrences(ids, x)))
  decreases |ids|
{
  if |ids| > 0 {
    var last := ids[|ids| - 1];
    var init := ids[0..|ids|-1];
    occurrences_ensures(init, id);
    if last != id {
      withoutLast_ensures(init, id);
      forall x {
        OccurrencesSnoc(withoutLast(init, id), last, x);
      }
    }
  }
}

function withoutAll(ids: seq<string>, id: string): seq<string>
  decreases |ids|
{
  if (|ids| == 0) then
    []
  else
    var last := ids[(|ids| - 1)];
    var rest := withoutAll(ids[0..|ids|-1], id);
    if (last == id) then
      rest
    else
      (rest + [last])
}

lemma withoutAll_ensures(ids: seq<string>, id: string)
  ensures (occurrences(withoutAll(ids, id), id) == 0)
  ensures forall x :: ((x != id) ==> (occurrences(withoutAll(ids, id), x) == occurrences(ids, x)))
  decreases |ids|
{
  if |ids| > 0 {
    var last := ids[|ids| - 1];
    var init := ids[0..|ids|-1];
    withoutAll_ensures(init, id);
    if last != id {
      forall x {
        OccurrencesSnoc(withoutAll(init, id), last, x);
      }
    }
  }
}

function stepsOf(s: Steps, kind: StepKind): seq<string>
{
  if kind.undo? then
    s.undo
  else
    s.redo
}

function added(s: Steps, kind: StepKind, stack: string): Steps
{
  if kind.undo? then
    Steps((s.undo + [stack]), s.redo)
  else
    Steps(s.undo, (s.redo + [stack]))
}

lemma added_ensures(s: Steps, kind: StepKind, stack: string)
  ensures (occurrences(stepsOf(added(s, kind, stack), kind), stack) == (occurrences(stepsOf(s, kind), stack) + 1))
  ensures forall k: StepKind, x :: (((k != kind) || (x != stack)) ==> (occurrences(stepsOf(added(s, kind, stack), k), x) == occurrences(stepsOf(s, k), x)))
  ensures (stepsOf(added(s, kind, stack), kind)[(|stepsOf(added(s, kind, stack), kind)| - 1)] == stack)
{
  forall x
    ensures occurrences(s.undo + [stack], x) == occurrences(s.undo, x) + (if x == stack then 1 else 0)
    ensures occurrences(s.redo + [stack], x) == occurrences(s.redo, x) + (if x == stack then 1 else 0)
  {
    OccurrencesSnoc(s.undo, stack, x);
    OccurrencesSnoc(s.redo, stack, x);
  }
}

function popped(s: Steps, kind: StepKind, stack: string): Steps
{
  if kind.undo? then
    Steps(withoutLast(s.undo, stack), s.redo)
  else
    Steps(s.undo, withoutLast(s.redo, stack))
}

lemma popped_ensures(s: Steps, kind: StepKind, stack: string)
  ensures (occurrences(stepsOf(popped(s, kind, stack), kind), stack) == (if (occurrences(stepsOf(s, kind), stack) > 0) then (occurrences(stepsOf(s, kind), stack) - 1) else 0))
  ensures forall k: StepKind, x :: (((k != kind) || (x != stack)) ==> (occurrences(stepsOf(popped(s, kind, stack), k), x) == occurrences(stepsOf(s, k), x)))
{
  withoutLast_ensures(s.undo, stack);
  withoutLast_ensures(s.redo, stack);
}

function cleared(s: Steps, stack: string, kinds: Clearing): Steps
{
  Steps((if kinds.undo then withoutAll(s.undo, stack) else s.undo), (if kinds.redo then withoutAll(s.redo, stack) else s.redo))
}

lemma cleared_ensures(s: Steps, stack: string, kinds: Clearing)
  ensures (kinds.undo ==> (occurrences(cleared(s, stack, kinds).undo, stack) == 0))
  ensures (kinds.redo ==> (occurrences(cleared(s, stack, kinds).redo, stack) == 0))
  ensures (!(kinds.undo) ==> (cleared(s, stack, kinds).undo == s.undo))
  ensures (!(kinds.redo) ==> (cleared(s, stack, kinds).redo == s.redo))
  ensures forall x :: ((x != stack) ==> ((occurrences(cleared(s, stack, kinds).undo, x) == occurrences(s.undo, x)) && (occurrences(cleared(s, stack, kinds).redo, x) == occurrences(s.redo, x))))
{
  withoutAll_ensures(s.undo, stack);
  withoutAll_ensures(s.redo, stack);
}
