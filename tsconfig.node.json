{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],

    /* Node mode */
    "module": "nodenext",

    /* Linting */
    "erasableSyntaxOnly": true
  },
  "include": [
    "vite.config.ts",
    "scripts/generateDiceFallbacks.ts",
    "scripts/generateIcons.ts",
    "lint"
  ]
}
